/// This table contains a record for each played Dead by Daylight game. These can vary from regular online matches, solo queues or competitive tournament matches.
table Games
	lineageTag: 05cd43fe-b272-4664-9cf5-84f4efa446f2
	sourceLineageTag: [facts].[fact_games]

	measure 'Total games' = COUNTROWS ( Games )
		formatString: #,0
		lineageTag: 178de2e8-35aa-43bd-aeae-408f9c9c6d51

		changedProperty = Name

	measure 'Total games escaped' =
			CALCULATE (
			    [Total games],
			    'Game Info'[Did Escape] = TRUE ()
			)
		formatString: #,0
		lineageTag: ed690608-85e4-46e4-b708-b4ca29f4a838

	measure 'Escape rate' =
			DIVIDE(
						[Total games escaped],
						[Total games]
					)
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: c635f590-d0ff-4024-a8a9-34a328c9ee41

		changedProperty = FormatString

	measure 'Total bloodpoints' =
			CALCULATE (
			    SUM ( Games[Blood Points] ),
			    'Game Info'[Is Valid Game] = TRUE ()
			)
		formatString: #,0
		lineageTag: 78300f28-25e2-4d3b-8cfb-63705eca5369

		changedProperty = Name

	measure 'Total hook stages' = CALCULATE(SUM(Games[Team Hook Stages]), 'Game Info'[Is Valid Game] = TRUE())
		formatString: #,0
		lineageTag: 9ebb20b5-0558-42d6-b734-d185b4be1371

	measure 'Total personal hook stages' = CALCULATE(SUM(Games[Personal Hook Stages]), 'Game Info'[Is Valid Game] = TRUE())
		formatString: #,0
		lineageTag: ba5fac8a-cf75-4507-ae64-4ac35117c2cf

	measure 'Total generators completed' = CALCULATE(SUM(Games[Generators Completed]), 'Game Info'[Is Valid Game] = TRUE())
		formatString: #,0
		lineageTag: 3408212a-f3f0-4392-ae54-34a0147d3bdf

	measure 'Total fresh hooks' = CALCULATE(SUM(Games[Fresh Hooks]), 'Game Info'[Is Valid Game] = TRUE())
		formatString: #,0
		lineageTag: 55543e82-9f57-42b3-b6de-80dd1f386d70

